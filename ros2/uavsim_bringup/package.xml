<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uavsim_bringup</name>
  <version>0.1.0</version>
  <description>
    ROS 2 bringup for the uavsim rescue environment: launches a scenario and the
    generated ros_gz_bridge. Mission logic belongs to the framework under test,
    not to this package.
  </description>
  <maintainer email="nirmanjaiswal0369@gmail.com">swadhin</maintainer>
  <license>LGPL-3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
