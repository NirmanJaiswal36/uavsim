{# Mission targets inside the ROI: fire markers and casualties.

   Kept out of the ROI scenery on purpose -- the scenario decides what a run is
   searching for, and every position placed here is written to the run manifest
   as ground truth. Both are static visuals; nothing here affects flight. #}
{% for f in fires %}
    <model name="fire_{{ loop.index0 }}">
      <static>true</static>
      <pose>{{ f[0] }} {{ f[1] }} {{ f[2] }} 0 0 0</pose>
      <link name="link">
        <visual name="core">
          <geometry><cone><radius>0.80</radius><length>2.20</length></cone></geometry>
          <material>
            <ambient>1 0.25 0 1</ambient><diffuse>1 0.4 0 1</diffuse><emissive>1 0.5 0 1</emissive>
          </material>
        </visual>
        <visual name="base">
          <pose>0 0 -0.2 0 0 0</pose>
          <geometry><cylinder><radius>1.10</radius><length>0.40</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.15 0 1</ambient><diffuse>0.9 0.2 0 1</diffuse><emissive>0.9 0.2 0 1</emissive>
          </material>
        </visual>
{% if fire_lights %}
        <light name="fire_{{ loop.index0 }}_light" type="point">
          <pose>0 0 1.2 0 0 0</pose>
          <diffuse>1 0.45 0 1</diffuse>
          <specular>1 0.6 0.1 1</specular>
          <attenuation><range>25</range><linear>0.08</linear><constant>0.1</constant><quadratic>0.01</quadratic></attenuation>
          <cast_shadows>false</cast_shadows>
        </light>
{% endif %}
      </link>
    </model>
{% endfor %}
{% for c in casualties %}
    <model name="casualty_{{ loop.index0 }}">
      <static>true</static>
      <pose>{{ c[0] }} {{ c[1] }} 0 0 0 {{ c[2] }}</pose>
      <link name="link">
        <!-- prone figure in a high-visibility vest: deliberately simple so the
             world loads without any Fuel download -->
        <visual name="torso">
          <pose>0 0 0.18 0 1.5708 0</pose>
          <geometry><capsule><radius>0.18</radius><length>0.55</length></capsule></geometry>
          <material>
            <ambient>0.85 0.35 0 1</ambient><diffuse>1 0.45 0 1</diffuse><emissive>0.25 0.1 0 1</emissive>
          </material>
        </visual>
        <visual name="legs">
          <pose>-0.55 0 0.14 0 1.5708 0</pose>
          <geometry><capsule><radius>0.13</radius><length>0.55</length></capsule></geometry>
          <material>
            <ambient>0.15 0.15 0.2 1</ambient><diffuse>0.2 0.2 0.28 1</diffuse>
          </material>
        </visual>
        <visual name="head">
          <pose>0.45 0 0.16 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material>
            <ambient>0.7 0.55 0.45 1</ambient><diffuse>0.85 0.68 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
{% endfor %}
