{# Ground control station site: apron pads, shelter, mast, windsock.

   Every number comes from uavsim/site.py, the same object the allocator uses to
   place vehicles, so what you see is where they spawn. There is no runway: every
   vehicle is a multirotor and takes off from a pad.

   No <plane> geometry anywhere: a plane collision is an infinite half-space in
   DART, and a second one in the world makes the ground-contact LCP singular and
   freezes the physics step. The apron and pads are thin boxes and cylinders.

   Stacked surfaces are kept >= 1 cm apart (terrain top -5 cm, apron top +1 cm,
   pads 2-4 cm): closer than that they z-fight and flicker when viewed from a
   distance. #}
    <model name="{{ site_name }}">
      <static>true</static>
      <pose>{{ pose }}</pose>
      <link name="link">

        <!-- apron and landing pads -->
        <visual name="apron">
          <pose>{{ site.apron_x_m }} {{ site.apron_y_m }} 0.005 0 0 0</pose>
          <geometry>
            <box>
              <size>{{ site.apron_length_m }} {{ site.apron_width_m }} 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.32 0.30 0.28 1</ambient><diffuse>0.38 0.36 0.33 1</diffuse>
          </material>
        </visual>
{% for slot in pads %}
        <visual name="pad_{{ loop.index0 }}">
          <pose>{{ slot.x }} {{ slot.y }} 0.03 0 0 0</pose>
          <geometry>
            <cylinder><radius>{{ site.pad_radius_m }}</radius><length>0.02</length></cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
{% endfor %}

        <!-- operations shelter -->
        <visual name="shelter">
          <pose>{{ site.apron_x_m }} {{ site.apron_y_m - (site.pad_cols * site.pad_spacing_m / 2) - 8 }} 1.5 0 0 0</pose>
          <geometry><box><size>8 4 3</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.80 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
        <collision name="shelter_collision">
          <pose>{{ site.apron_x_m }} {{ site.apron_y_m - (site.pad_cols * site.pad_spacing_m / 2) - 8 }} 1.5 0 0 0</pose>
          <geometry><box><size>8 4 3</size></box></geometry>
        </collision>

        <!-- antenna mast -->
        <visual name="mast">
          <pose>{{ site.apron_x_m + 6 }} {{ site.apron_y_m - (site.pad_cols * site.pad_spacing_m / 2) - 8 }} 5 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>10</length></cylinder></geometry>
          <material>
            <ambient>0.6 0.1 0.1 1</ambient><diffuse>0.8 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <collision name="mast_collision">
          <pose>{{ site.apron_x_m + 6 }} {{ site.apron_y_m - (site.pad_cols * site.pad_spacing_m / 2) - 8 }} 5 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>10</length></cylinder></geometry>
        </collision>

        <!-- windsock, at the forest-facing corner of the apron -->
        <visual name="windsock_pole">
          <pose>{{ site.front_x_m }} {{ site.apron_y_m + site.apron_width_m / 2 + 3 }} 2 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>4</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
        <visual name="windsock">
          <pose>{{ site.front_x_m - 0.9 }} {{ site.apron_y_m + site.apron_width_m / 2 + 3 }} 3.9 0 -1.5708 0</pose>
          <geometry><cone><radius>0.35</radius><length>1.8</length></cone></geometry>
          <material>
            <ambient>0.9 0.45 0 1</ambient><diffuse>1 0.5 0 1</diffuse>
          </material>
        </visual>

      </link>
    </model>
