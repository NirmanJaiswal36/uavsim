{# Search-and-rescue regions of interest: a themed prop plus a co-located ArUco plate.

   Why both.  The prop is what makes the scene read as a search problem to a human;
   the marker is what makes a detection *scoreable*, because the run manifest says
   exactly which ArUco id sits at which lat/lon.  Neither alone is enough.

   Primitives only, deliberately -- cone, cylinder, capsule, sphere, box.  Nothing
   here is a Fuel model, so adding ROIs costs nothing on first start, and nothing here
   is a <plane>: uavsim/verify.py counts plane geometry in the world text and there
   must be exactly one, in base_world.sdf.j2.  The marker itself IS a plane, which is
   why it lives in models/aruco_marker_<id>/ and arrives by <include> -- geometry
   inside an included model never enters the world text.

   Kept separate from targets.sdf.j2 on purpose: that file is two flat loops over
   [x, y, z] triples, these are compound models with five variants, and merging them
   would bury both. #}
{% macro survivor() %}
        <!-- a casualty in a hi-vis vest, prone, arms out -->
        <visual name="torso">
          <pose>0 0 0.18 0 1.5708 0</pose>
          <geometry><capsule><radius>0.18</radius><length>0.55</length></capsule></geometry>
          <material>
            <ambient>0.85 0.35 0 1</ambient><diffuse>1 0.45 0 1</diffuse><emissive>0.25 0.1 0 1</emissive>
          </material>
        </visual>
        <visual name="legs">
          <pose>-0.55 0 0.14 0 1.5708 0</pose>
          <geometry><capsule><radius>0.13</radius><length>0.55</length></capsule></geometry>
          <material>
            <ambient>0.15 0.15 0.2 1</ambient><diffuse>0.2 0.2 0.28 1</diffuse>
          </material>
        </visual>
        <visual name="head">
          <pose>0.45 0 0.16 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material>
            <ambient>0.7 0.55 0.45 1</ambient><diffuse>0.85 0.68 0.55 1</diffuse>
          </material>
        </visual>
        <visual name="arm">
          <pose>0.1 0.42 0.12 1.5708 0 0</pose>
          <geometry><capsule><radius>0.09</radius><length>0.45</length></capsule></geometry>
          <material>
            <ambient>0.85 0.35 0 1</ambient><diffuse>1 0.45 0 1</diffuse>
          </material>
        </visual>
{% endmacro %}
{% macro wreckage() %}
        <!-- a broken fuselage section with a scorch mark around it -->
        <visual name="scorch">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry><cylinder><radius>3.20</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.07 0.06 0.05 1</ambient><diffuse>0.1 0.09 0.07 1</diffuse><specular>0 0 0 1</specular>
          </material>
        </visual>
        <visual name="fuselage">
          <pose>0 0 0.75 0 1.3 0.2</pose>
          <geometry><cylinder><radius>0.80</radius><length>4.40</length></cylinder></geometry>
          <material>
            <ambient>0.55 0.56 0.58 1</ambient><diffuse>0.72 0.73 0.75 1</diffuse>
          </material>
        </visual>
        <visual name="wing_stub_port">
          <pose>-0.4 1.70 0.35 0 0.1 0.35</pose>
          <geometry><box><size>2.60 0.90 0.14</size></box></geometry>
          <material>
            <ambient>0.5 0.51 0.53 1</ambient><diffuse>0.66 0.67 0.69 1</diffuse>
          </material>
        </visual>
        <visual name="wing_stub_starboard">
          <pose>0.6 -1.55 0.22 0 -0.08 -0.5</pose>
          <geometry><box><size>2.20 0.85 0.14</size></box></geometry>
          <material>
            <ambient>0.5 0.51 0.53 1</ambient><diffuse>0.66 0.67 0.69 1</diffuse>
          </material>
        </visual>
        <visual name="charred_tail">
          <pose>-2.40 -0.30 0.60 0 2.2 0</pose>
          <geometry><cone><radius>0.65</radius><length>1.80</length></cone></geometry>
          <material>
            <ambient>0.12 0.1 0.09 1</ambient><diffuse>0.18 0.15 0.13 1</diffuse>
          </material>
        </visual>
{% endmacro %}
{% macro tent() %}
        <!-- a ridge tent: two sloped panels, a pole, and a hi-vis ground sheet -->
        <visual name="panel_left">
          <pose>0 -0.62 0.62 0.9 0 0</pose>
          <geometry><box><size>2.60 1.65 0.06</size></box></geometry>
          <material>
            <ambient>0.1 0.3 0.2 1</ambient><diffuse>0.14 0.42 0.28 1</diffuse>
          </material>
        </visual>
        <visual name="panel_right">
          <pose>0 0.62 0.62 -0.9 0 0</pose>
          <geometry><box><size>2.60 1.65 0.06</size></box></geometry>
          <material>
            <ambient>0.1 0.3 0.2 1</ambient><diffuse>0.14 0.42 0.28 1</diffuse>
          </material>
        </visual>
        <visual name="ridge_pole">
          <pose>0 0 1.30 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>2.80</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.28 0.25 1</ambient><diffuse>0.4 0.37 0.33 1</diffuse>
          </material>
        </visual>
        <visual name="ground_sheet">
          <pose>1.70 0 0.02 0 0 0</pose>
          <geometry><box><size>1.10 1.60 0.04</size></box></geometry>
          <material>
            <ambient>0.85 0.4 0 1</ambient><diffuse>1 0.5 0 1</diffuse><emissive>0.2 0.08 0 1</emissive>
          </material>
        </visual>
{% endmacro %}
{% macro crate() %}
        <!-- an air-dropped supply crate with its canopy collapsed beside it -->
        <visual name="box">
          <pose>0 0 0.60 0 0 0</pose>
          <geometry><box><size>1.20 1.20 1.20</size></box></geometry>
          <material>
            <ambient>0.42 0.3 0.16 1</ambient><diffuse>0.6 0.44 0.22 1</diffuse>
          </material>
        </visual>
        <visual name="strap_x">
          <pose>0 0 0.60 0 0 0</pose>
          <geometry><box><size>1.26 0.14 1.26</size></box></geometry>
          <material>
            <ambient>0.8 0.45 0 1</ambient><diffuse>1 0.55 0 1</diffuse><emissive>0.2 0.1 0 1</emissive>
          </material>
        </visual>
        <visual name="strap_y">
          <pose>0 0 0.60 0 0 0</pose>
          <geometry><box><size>0.14 1.26 1.26</size></box></geometry>
          <material>
            <ambient>0.8 0.45 0 1</ambient><diffuse>1 0.55 0 1</diffuse><emissive>0.2 0.1 0 1</emissive>
          </material>
        </visual>
        <visual name="canopy">
          <pose>-2.10 0.40 0.08 0 0 0</pose>
          <geometry><cylinder><radius>1.90</radius><length>0.16</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse>
          </material>
        </visual>
{% endmacro %}
{% macro signal_fire() %}
        <!-- a signal fire: the one ROI type that is visible from outside the canopy -->
        <visual name="flame">
          <pose>0 0 1.10 0 0 0</pose>
          <geometry><cone><radius>0.80</radius><length>2.20</length></cone></geometry>
          <material>
            <ambient>1 0.25 0 1</ambient><diffuse>1 0.4 0 1</diffuse><emissive>1 0.5 0 1</emissive>
          </material>
        </visual>
        <visual name="embers">
          <pose>0 0 0.20 0 0 0</pose>
          <geometry><cylinder><radius>1.10</radius><length>0.40</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.15 0 1</ambient><diffuse>0.9 0.2 0 1</diffuse><emissive>0.9 0.2 0 1</emissive>
          </material>
        </visual>
{# three logs at 120 degrees on a 1.5 m circle; x, y, yaw precomputed because
   Jinja has no trig filters #}
{% for lx, ly, lyaw in [(1.50, 0.00, 0.000), (-0.75, 1.30, 2.094), (-0.75, -1.30, 4.189)] %}
        <visual name="log_{{ loop.index0 }}">
          <pose>{{ lx }} {{ ly }} 0.18 0 1.5708 {{ lyaw }}</pose>
          <geometry><cylinder><radius>0.16</radius><length>1.60</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.14 0.09 1</ambient><diffuse>0.28 0.2 0.13 1</diffuse>
          </material>
        </visual>
{% endfor %}
{% endmacro %}
{% set props = {'survivor': survivor, 'wreckage': wreckage, 'tent': tent,
                'crate': crate, 'signal_fire': signal_fire} %}
{# Entity names are neutral ("site_<k>", k a seeded shuffle) and the sites are listed
   in k order, so neither gz's entity list nor the SDF order says which site carries
   which marker id or prop type. #}
{% for r in rois %}
    <model name="site_{{ r.site }}">
      <static>true</static>
      <pose>{{ '%.2f'|format(r.x) }} {{ '%.2f'|format(r.y) }} 0 0 0 {{ '%.3f'|format(r.yaw) }}</pose>
      <link name="link">
{{ props[r.type]() }}
      </link>
    </model>
    {# the plate is offset along the prop's heading far enough to clear its footprint
       (uavsim/world.py: PROP_FOOTPRINTS, marker_offset_m), and is always axis-aligned
       and horizontal: a nadir detector's pose output is then trivially interpretable.
       marker_z sits above every ground-hugging visual, so nothing z-fights the plate #}
    <include>
      <uri>model://aruco_marker_{{ r.aruco_id }}</uri>
      <name>site_{{ r.site }}_plate</name>
      <pose>{{ '%.2f'|format(r.marker_x) }} {{ '%.2f'|format(r.marker_y) }} {{ '%.2f'|format(marker_z) }} 0 0 0</pose>
    </include>
{% endfor %}
