{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scenario",
  "type": "object",
  "required": ["fleet"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string"},
    "world": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "roi": {"type": "string"},
        "gcs_site": {"type": "string"},
        "gcs_pose": {"type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6},
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "latitude_deg": {"type": "number"},
            "longitude_deg": {"type": "number"},
            "elevation_m": {"type": "number"}
          }
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rois": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "count": {"type": "integer", "minimum": 0, "maximum": 10,
                      "description": "capped at the number of aruco_marker_* models that ship"},
            "seed": {"oneOf": [{"type": "integer"}, {"const": "random"}],
                     "description": "omit (or 'random') for a fresh layout every 'uavsim up'"},
            "types": {
              "type": "array",
              "items": {"enum": ["survivor", "wreckage", "tent", "crate", "signal_fire"]}
            },
            "marker_dict": {"enum": ["4x4_50"]},
            "marker_size_m": {"type": "number", "exclusiveMinimum": 0,
                              "description": "must match models/aruco_marker_*/ (3 m)"},
            "first_marker_id": {"type": "integer", "minimum": 0},
            "min_tree_m": {"type": "number", "minimum": 0},
            "marker_min_tree_m": {"type": "number", "minimum": 0},
            "positions": {
              "type": "array",
              "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 3}
            }
          }
        }
      }
    },
    "fleet": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {"type": "string"},
          "count": {"type": "integer", "minimum": 1},
          "name_prefix": {"type": "string"},
          "backend_config": {"type": "object"},
          "payload_params": {"type": "object"}
        }
      }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {"enum": ["grid", "line"]},
        "spacing_m": {"type": "number", "exclusiveMinimum": 0},
        "heading_deg": {"type": "number"}
      }
    },
    "ros2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bridge": {"type": "boolean"},
        "clock": {"type": "boolean"}
      }
    },
    "backends": {"type": "object", "description": "backend id -> settings overrides"},
    "supervisor": {"enum": ["tmux", "subprocess"]},
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "description": "the pose log every run leaves in uavsim_runs/ (in the repo) for the judges",
      "properties": {
        "enabled": {"type": "boolean"},
        "team": {"type": "string", "description": "names the log; 'uavsim up --team' overrides"},
        "rate_hz": {"type": "number", "exclusiveMinimum": 0, "maximum": 60}
      }
    },
    "gazebo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headless": {"type": "boolean"},
        "verbosity": {"type": "integer", "minimum": 0, "maximum": 4},
        "start": {"type": "boolean", "description": "false = attach to an already running server"}
      }
    }
  }
}
